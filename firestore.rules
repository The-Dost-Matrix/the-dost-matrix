rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsResource() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function createsOwnResource() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /missions/{missionId} {
      allow create: if createsOwnResource();
      allow read, update, delete: if ownsResource();
    }

    match /auditEvents/{eventId} {
      allow create: if createsOwnResource();
      allow read: if ownsResource();
      allow update, delete: if false;
    }

    // chatMessages and knowledge are only ever written by the server
    // (Admin SDK, via /api/chat) so that LLM/embedding calls never need
    // secrets in the browser. The client may only read its own data.
    match /chatMessages/{messageId} {
      allow read: if ownsResource();
      allow create, update, delete: if false;
    }

    match /knowledge/{entryId} {
      allow read: if ownsResource();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
